import os
import time
import requests

def get_current_ip():
    try:
        return requests.get("https://api.ipify.org", timeout=5).text
    except Exception:
        return "IP Alınamadı (İnternet/DNS Hatası)"

def change_ip_tor():
    print(f"\n[+] Mevcut IP: {get_current_ip()}")
    print("[*] Tor servisi üzerinden yeni IP alınıyor...")
    
    # Tor / Anonsurf servisini kullanarak IP değiştirme
    os.system("sudo anonsurf change 2>/dev/null || sudo service tor reload 2>/dev/null")
    time.sleep(3)
    
    print(f"[✓] Yeni IP Adresi: {get_current_ip()}\n")

def auto_rotate_ip(interval):
    print(f"\n[*] Otomatik IP değiştirici başlatıldı. Her {interval} saniyede bir IP yenilenecek.")
    print("[!] Durdurmak için CTRL + C yapın.\n")
    try:
        while True:
            change_ip_tor()
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\n[!] Otomatik IP değiştirici durduruldu.")

def ip_changer_menu():
    while True:
        print("\n=== WEBRAKS IP CHANGER ===")
        print("[1] Anlık IP Adresini Göster")
        print("[2] Manuel IP Değiştir (Tor / Anonsurf)")
        print("[3] Otomatik IP Değiştirici (Döngü)")
        print("[0] Ana Menüye Dön")
        
        secim = input("\nSeçiminiz: ")
        
        if secim == "1":
            print(f"\n[+] Aktif IP: {get_current_ip()}")
        elif secim == "2":
            change_ip_tor()
        elif secim == "3":
            sec = int(input("Kaç saniyede bir IP değişsin? (Örn: 30): "))
            auto_rotate_ip(sec)
        elif secim == "0":
            break
        else:
            print("[!] Geçersiz seçim.")

if __name__ == "__main__":
    ip_changer_menu()
